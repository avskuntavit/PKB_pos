APP_NAME="PKB POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000
APP_LOCALE=th
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# sqlsrv = SQL Server / mysql / sqlite
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=foodpos
DB_USERNAME=sa
DB_PASSWORD=

# คำนำหน้าชื่อตาราง — ฐานข้อมูลนี้มีระบบเดิมที่ใช้ pos_ อยู่แล้ว
DB_PREFIX=POS2_

# ODBC Driver 18 เปิด encrypt เป็นค่าเริ่มต้น
# เซิร์ฟเวอร์ภายในที่ใช้ self-signed certificate ต้องปล่อย trust เป็น true
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=480
QUEUE_CONNECTION=database
CACHE_STORE=database

# OTP ล็อกอินลูกค้า — ยังไม่ได้ต่อผู้ให้บริการ SMS
# log = เขียนรหัสลง storage/logs / null = ไม่ส่งอะไรเลย
FOODPOS_OTP_DRIVER=log
FOODPOS_OTP_TTL=5
# โหมดทดสอบ: แสดงรหัสบนหน้าจอเลย (ห้ามเปิดบน production)
FOODPOS_OTP_EXPOSE=false

VITE_APP_NAME="${APP_NAME}"
