# ──────────────────────────────────────────────────────────────
# ก่อนเอาขึ้นเครื่องจริง ต้องเปลี่ยนสี่ค่านี้ให้ครบ
#
#   APP_ENV=production
#   APP_DEBUG=false          ถ้าเปิดค้าง หน้า error จะโชว์ค่า env ทั้งหมดรวม APP_KEY
#   APP_URL=                 IP หรือโดเมนที่มือถือลูกค้าในร้านเรียกถึงได้ ห้ามเป็น localhost
#                            ไม่งั้น QR โต๊ะและลิงก์ที่ระบบสร้างใช้ไม่ได้
#   FOODPOS_OTP_EXPOSE=false ถ้าเปิดค้าง ใครก็ล็อกอินเป็นลูกค้าคนไหนก็ได้
#
# (config/foodpos.php บังคับปิด OTP_EXPOSE ซ้ำอีกชั้นเมื่อ APP_ENV=production
#  แต่อย่าพึ่งชั้นนั้นอย่างเดียว ตั้งให้ถูกตั้งแต่ตรงนี้)
# ──────────────────────────────────────────────────────────────

APP_NAME="PKB POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000
APP_LOCALE=th
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# sqlsrv = SQL Server / mysql / sqlite
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=foodpos
DB_USERNAME=sa
DB_PASSWORD=

# คำนำหน้าชื่อตาราง — ฐานข้อมูลนี้มีระบบเดิมที่ใช้ pos_ อยู่แล้ว
DB_PREFIX=POS2_

# ODBC Driver 18 เปิด encrypt เป็นค่าเริ่มต้น
# เซิร์ฟเวอร์ภายในที่ใช้ self-signed certificate ต้องปล่อย trust เป็น true
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=480
QUEUE_CONNECTION=database
CACHE_STORE=database

# OTP ล็อกอินลูกค้า — ยังไม่ได้ต่อผู้ให้บริการ SMS
# log = เขียนรหัสลง storage/logs / null = ไม่ส่งอะไรเลย
FOODPOS_OTP_DRIVER=log
FOODPOS_OTP_TTL=5
# โหมดทดสอบ: แสดงรหัสบนหน้าจอเลย (ห้ามเปิดบน production)
FOODPOS_OTP_EXPOSE=false

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────
# การสำรองข้อมูล และการเฝ้าดู error — ดูคำอธิบายเต็มใน config/monitoring.php
# ──────────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_TIME=03:30

# โฟลเดอร์บน "เครื่อง SQL Server" ไม่ใช่เครื่องที่แอปรันอยู่
# คนเขียนไฟล์ .bak คือ SQL Server ต้องให้สิทธิ์เขียนกับ service account ของมัน
# เก็บไว้เครื่องเดียวกับฐานข้อมูลกันได้แค่ "ลบข้อมูลผิด" — ดิสก์พังหรือไฟไหม้หายพร้อมกัน
BACKUP_SQL_PATH=C:\PosBackup

# ตรวจไฟล์ที่เพิ่งสำรองด้วย RESTORE VERIFYONLY (ช้าขึ้นเท่าตัว แต่รู้ว่าไฟล์กู้ได้จริง)
BACKUP_VERIFY=true

# SQL Server Express กับ Web edition ไม่รองรับ เปิดแล้วจะได้ error 1844
BACKUP_COMPRESSION=false

# ขาดการสำรองเกินกี่ชั่วโมงจึงขึ้นเตือนบนหลังบ้าน
BACKUP_STALE_HOURS=30

# ตัวตั้งเวลาเงียบเกินกี่นาทีถือว่าตาย (มันเคาะทุก 5 นาที)
SCHEDULER_STALE_MINUTES=20

# ERROR_MONITOR_PRUNE_DAYS=90

# ──────────────────────────────────────────────────────────────
# ชื่อและโลโก้ระบบ — ค่าตั้งต้นอยู่ใน config/pos.php ไม่ต้องตั้งก็ได้
# ──────────────────────────────────────────────────────────────
# POS_BRAND_LOGO=/storage/icon/pos_icon-225x169.png
# POS_BRAND_MARK=/storage/icon/pos_icon-mark.png
# POS_BRAND_FAVICON=/storage/icon/pos_icon.ico

# ──────────────────────────────────────────────────────────────
# ส่งข้อมูลการขายให้ระบบบัญชี (SAM) — ดูคำอธิบายเต็มใน config/pos.php
# ──────────────────────────────────────────────────────────────
# SALES_EXPORT_DRIVER=file
# SALES_EXPORT_DETAIL=both          summary | bills | both
# SALES_EXPORT_FORMAT=json          json | csv
# SALES_EXPORT_ENCODING=utf-8       utf-8 | tis-620
# SALES_EXPORT_PATH=exports/sam
